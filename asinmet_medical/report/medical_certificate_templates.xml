<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_medical_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Encabezado -->
                        <div class="text-center mb-4">
                            <h2>CERTIFICADO DE APTITUD</h2>
                            <h4 class="text-muted">
                                <t t-out="doc.name"/>
                            </h4>
                        </div>

                        <!-- Datos del paciente -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold">Paciente:</td>
                                        <td><t t-out="doc.patient_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">DNI:</td>
                                        <td><t t-out="doc.patient_id.dni"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Fecha Nacimiento:</td>
                                        <td><t t-out="doc.patient_id.birth_date" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold">Empresa:</td>
                                        <td><t t-out="doc.employer_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Puesto:</td>
                                        <td><t t-out="doc.order_id.job_position"/></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Tipo Examen:</td>
                                        <td><t t-out="dict(doc.order_id._fields['examination_type'].selection).get(doc.order_id.examination_type)"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Tabla de estudios realizados -->
                        <h5 class="mt-4">Estudios Realizados</h5>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Estudio</th>
                                    <th>Profesional</th>
                                    <th>Resultado</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_id.study_request_ids" t-as="study">
                                    <tr>
                                        <td><t t-out="study.study_type_id.name"/></td>
                                        <td><t t-out="study.practitioner_id.name or '-'"/></td>
                                        <td>
                                            <t t-foreach="study.result_ids" t-as="result">
                                                <t t-if="result.aptitude">
                                                    <t t-out="dict(result._fields['aptitude'].selection).get(result.aptitude)"/>
                                                </t>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-foreach="study.result_ids" t-as="result">
                                                <t t-out="result.date" t-options='{"widget": "date"}'/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Dictamen -->
                        <div class="mt-4 p-3 border border-dark text-center"
                             style="border-width: 3px !important;">
                            <h3>
                                DICTAMEN:
                                <strong>
                                    <t t-if="doc.dictamen == 'apto'">APTO</t>
                                    <t t-if="doc.dictamen == 'no_apto'">NO APTO</t>
                                    <t t-if="doc.dictamen == 'apto_obs'">APTO CON OBSERVACIONES</t>
                                </strong>
                            </h3>
                        </div>

                        <!-- Observaciones -->
                        <t t-if="doc.observations">
                            <div class="mt-3">
                                <strong>Observaciones:</strong>
                                <p><t t-out="doc.observations"/></p>
                            </div>
                        </t>

                        <!-- Firma -->
                        <div class="mt-5 text-center" style="page-break-inside: avoid;">
                            <t t-if="doc.signature">
                                <img t-att-src="image_data_uri(doc.signature)"
                                     style="max-height: 80px;"/>
                                <br/>
                            </t>
                            <div class="mt-2" style="border-top: 1px solid #000; display: inline-block; padding-top: 5px; min-width: 300px;">
                                <strong><t t-out="doc.practitioner_id.name"/></strong><br/>
                                <span>Matrícula: <t t-out="doc.practitioner_id.license_number"/></span><br/>
                                <span>Fecha: <t t-out="doc.signed_date" t-options='{"widget": "date"}'/></span>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
