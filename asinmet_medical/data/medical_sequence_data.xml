<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia: Órdenes de Examen — EX-2026-00001 -->
    <record id="seq_medical_examination_order" model="ir.sequence">
        <field name="name">Orden de Examen Médico</field>
        <field name="code">medical.examination.order</field>
        <field name="prefix">EX-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Secuencia: Certificados — CERT-2026-00001 -->
    <record id="seq_medical_certificate" model="ir.sequence">
        <field name="name">Certificado de Aptitud</field>
        <field name="code">medical.certificate</field>
        <field name="prefix">CERT-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
