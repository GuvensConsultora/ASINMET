<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Estudios obligatorios según Res. SRT 37/2010 -->

    <record id="study_clinical" model="medical.study.type">
        <field name="name">Examen Clínico General</field>
        <field name="code">CLIN</field>
        <field name="specialty_id" ref="specialty_clinical"/>
        <field name="requires_attachment" eval="False"/>
    </record>

    <record id="study_laboratory" model="medical.study.type">
        <field name="name">Análisis de Laboratorio</field>
        <field name="code">LAB</field>
        <field name="specialty_id" ref="specialty_laboratory"/>
    </record>

    <record id="study_ecg" model="medical.study.type">
        <field name="name">Electrocardiograma (ECG)</field>
        <field name="code">ECG</field>
        <field name="specialty_id" ref="specialty_cardiology"/>
    </record>

    <record id="study_chest_xray" model="medical.study.type">
        <field name="name">Radiografía de Tórax</field>
        <field name="code">RX_TX</field>
        <field name="specialty_id" ref="specialty_radiology"/>
    </record>

    <record id="study_ophthalmology" model="medical.study.type">
        <field name="name">Examen Oftalmológico</field>
        <field name="code">OFT</field>
        <field name="specialty_id" ref="specialty_ophthalmology"/>
    </record>

    <record id="study_audiometry" model="medical.study.type">
        <field name="name">Audiometría</field>
        <field name="code">AUD</field>
        <field name="specialty_id" ref="specialty_audiology"/>
    </record>

    <record id="study_psychology" model="medical.study.type">
        <field name="name">Examen Psicológico</field>
        <field name="code">PSI</field>
        <field name="specialty_id" ref="specialty_psychology"/>
        <field name="requires_attachment" eval="False"/>
    </record>

    <record id="study_toxicology" model="medical.study.type">
        <field name="name">Análisis Toxicológico</field>
        <field name="code">TOX</field>
        <field name="specialty_id" ref="specialty_toxicology"/>
    </record>

    <record id="study_spirometry" model="medical.study.type">
        <field name="name">Espirometría</field>
        <field name="code">ESP</field>
        <field name="specialty_id" ref="specialty_pneumology"/>
    </record>

    <record id="study_ergometry" model="medical.study.type">
        <field name="name">Ergometría (ECG de esfuerzo)</field>
        <field name="code">ERG</field>
        <field name="specialty_id" ref="specialty_cardiology"/>
    </record>

    <!-- Parámetros de laboratorio (líneas del tipo de estudio) -->
    <record id="lab_param_glucose" model="medical.study.type.line">
        <field name="study_type_id" ref="study_laboratory"/>
        <field name="parameter">Glucemia</field>
        <field name="unit">g/l</field>
        <field name="reference_min">0.70</field>
        <field name="reference_max">1.10</field>
        <field name="sequence">10</field>
    </record>
    <record id="lab_param_urea" model="medical.study.type.line">
        <field name="study_type_id" ref="study_laboratory"/>
        <field name="parameter">Urea</field>
        <field name="unit">mg/dl</field>
        <field name="reference_min">15.0</field>
        <field name="reference_max">45.0</field>
        <field name="sequence">20</field>
    </record>
    <record id="lab_param_creatinine" model="medical.study.type.line">
        <field name="study_type_id" ref="study_laboratory"/>
        <field name="parameter">Creatinina</field>
        <field name="unit">mg/dl</field>
        <field name="reference_min">0.70</field>
        <field name="reference_max">1.30</field>
        <field name="sequence">30</field>
    </record>
    <record id="lab_param_hemoglobin" model="medical.study.type.line">
        <field name="study_type_id" ref="study_laboratory"/>
        <field name="parameter">Hemoglobina</field>
        <field name="unit">g/dl</field>
        <field name="reference_min">12.0</field>
        <field name="reference_max">17.0</field>
        <field name="sequence">40</field>
    </record>
    <record id="lab_param_hematocrit" model="medical.study.type.line">
        <field name="study_type_id" ref="study_laboratory"/>
        <field name="parameter">Hematocrito</field>
        <field name="unit">%</field>
        <field name="reference_min">36.0</field>
        <field name="reference_max">50.0</field>
        <field name="sequence">50</field>
    </record>
    <record id="lab_param_cholesterol" model="medical.study.type.line">
        <field name="study_type_id" ref="study_laboratory"/>
        <field name="parameter">Colesterol Total</field>
        <field name="unit">mg/dl</field>
        <field name="reference_min">0.0</field>
        <field name="reference_max">200.0</field>
        <field name="sequence">60</field>
    </record>
</odoo>
