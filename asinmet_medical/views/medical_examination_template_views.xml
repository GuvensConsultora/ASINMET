<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_examination_template_view_form" model="ir.ui.view">
        <field name="name">medical.examination.template.form</field>
        <field name="model">medical.examination.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la plantilla"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="estimated_duration" widget="float_time"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="study_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Estudios Incluidos" name="studies">
                            <field name="study_type_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="specialty_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_examination_template_view_list" model="ir.ui.view">
        <field name="name">medical.examination.template.list</field>
        <field name="model">medical.examination.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="study_count"/>
                <field name="estimated_duration" widget="float_time"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="medical_examination_template_action" model="ir.actions.act_window">
        <field name="name">Plantillas de Examen</field>
        <field name="res_model">medical.examination.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
