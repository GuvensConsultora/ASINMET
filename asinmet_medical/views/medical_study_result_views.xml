<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_study_result_view_form" model="ir.ui.view">
        <field name="name">medical.study.result.form</field>
        <field name="model">medical.study.result</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Estudio">
                            <field name="request_id"/>
                            <field name="study_type_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Profesional">
                            <field name="practitioner_id"/>
                            <field name="signed"/>
                            <field name="signed_date" invisible="not signed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parámetros" name="parameters">
                            <field name="result_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter"/>
                                    <field name="value"/>
                                    <field name="unit"/>
                                    <field name="reference_min"/>
                                    <field name="reference_max"/>
                                    <field name="is_abnormal" widget="boolean"
                                           decoration-danger="is_abnormal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Adjuntos" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                    <group string="Conclusión">
                        <field name="aptitude" widget="radio"/>
                        <field name="conclusion"/>
                    </group>
                    <group string="Firma" invisible="not signed">
                        <field name="signature" widget="image"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_study_result_view_list" model="ir.ui.view">
        <field name="name">medical.study.result.list</field>
        <field name="model">medical.study.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="study_type_id"/>
                <field name="practitioner_id"/>
                <field name="aptitude" widget="badge"
                       decoration-success="aptitude == 'normal'"
                       decoration-danger="aptitude == 'anormal'"
                       decoration-warning="aptitude == 'observaciones'"/>
                <field name="signed"/>
            </list>
        </field>
    </record>

    <record id="medical_study_result_action" model="ir.actions.act_window">
        <field name="name">Resultados de Estudios</field>
        <field name="res_model">medical.study.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
