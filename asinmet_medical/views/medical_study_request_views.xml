<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form -->
    <record id="medical_study_request_view_form" model="ir.ui.view">
        <field name="name">medical.study.request.form</field>
        <field name="model">medical.study.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Iniciar"
                            class="oe_highlight"
                            invisible="state != 'pendiente'"/>
                    <button name="action_complete" type="object" string="Completar"
                            class="oe_highlight"
                            invisible="state != 'en_proceso'"/>
                    <button name="action_validate" type="object" string="Validar"
                            class="oe_highlight"
                            invisible="state != 'completado'"
                            groups="asinmet_medical.group_auditor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pendiente,en_proceso,completado,validado"/>
                </header>
                <sheet>
                    <group>
                        <group string="Solicitud">
                            <field name="order_id"/>
                            <field name="study_type_id"/>
                            <field name="specialty_id"/>
                        </group>
                        <group string="Asignación">
                            <field name="practitioner_id"/>
                            <field name="patient_id"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resultados" name="results">
                            <field name="result_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="practitioner_id"/>
                                    <field name="aptitude" widget="badge"
                                           decoration-success="aptitude == 'normal'"
                                           decoration-danger="aptitude == 'anormal'"
                                           decoration-warning="aptitude == 'observaciones'"/>
                                    <field name="conclusion"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="medical_study_request_view_list" model="ir.ui.view">
        <field name="name">medical.study.request.list</field>
        <field name="model">medical.study.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="study_type_id"/>
                <field name="specialty_id"/>
                <field name="practitioner_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pendiente'"
                       decoration-warning="state == 'en_proceso'"
                       decoration-success="state in ('completado', 'validado')"/>
            </list>
        </field>
    </record>

    <!-- Kanban — Cola de trabajo del técnico -->
    <record id="medical_study_request_view_kanban" model="ir.ui.view">
        <field name="name">medical.study.request.kanban</field>
        <field name="model">medical.study.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="patient_id"/>
                <field name="study_type_id"/>
                <field name="practitioner_id"/>
                <field name="state"/>
                <field name="date"/>
                <templates>
                    <t t-name="card">
                        <field name="study_type_id" class="fw-bold"/>
                        <field name="patient_id"/>
                        <div class="text-muted small">
                            <field name="date"/>
                        </div>
                        <field name="practitioner_id" widget="many2one_avatar"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="medical_study_request_view_search" model="ir.ui.view">
        <field name="name">medical.study.request.search</field>
        <field name="model">medical.study.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="study_type_id"/>
                <field name="practitioner_id"/>
                <filter name="today" string="Hoy" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pendiente')]"/>
                <filter name="in_progress" string="En Proceso" domain="[('state', '=', 'en_proceso')]"/>
                <filter name="completed" string="Completados" domain="[('state', '=', 'completado')]"/>
                <separator/>
                <filter name="group_specialty" string="Especialidad" context="{'group_by': 'specialty_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_practitioner" string="Profesional" context="{'group_by': 'practitioner_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action: Cola de trabajo del técnico -->
    <record id="medical_study_request_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de Estudio</field>
        <field name="res_model">medical.study.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
