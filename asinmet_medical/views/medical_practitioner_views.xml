<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_practitioner_view_form" model="ir.ui.view">
        <field name="name">medical.practitioner.form</field>
        <field name="model">medical.practitioner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options='{"preview_image": "image_128"}'/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del profesional"/></h1>
                    </div>
                    <group>
                        <group string="Datos Profesionales">
                            <field name="license_number"/>
                            <field name="specialty_id"/>
                        </group>
                        <group string="Contacto">
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Firma Electrónica">
                        <field name="signature" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_practitioner_view_list" model="ir.ui.view">
        <field name="name">medical.practitioner.list</field>
        <field name="model">medical.practitioner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="license_number"/>
                <field name="specialty_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="medical_practitioner_view_search" model="ir.ui.view">
        <field name="name">medical.practitioner.search</field>
        <field name="model">medical.practitioner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_number"/>
                <field name="specialty_id"/>
                <separator/>
                <filter name="group_specialty" string="Especialidad" context="{'group_by': 'specialty_id'}"/>
            </search>
        </field>
    </record>

    <record id="medical_practitioner_action" model="ir.actions.act_window">
        <field name="name">Profesionales</field>
        <field name="res_model">medical.practitioner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
