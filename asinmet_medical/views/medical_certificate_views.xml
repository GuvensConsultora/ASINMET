<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form — Vista del médico auditor -->
    <record id="medical_certificate_view_form" model="ir.ui.view">
        <field name="name">medical.certificate.form</field>
        <field name="model">medical.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sign" type="object" string="Firmar y Emitir"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="asinmet_medical.group_auditor"/>
                    <button name="action_deliver" type="object" string="Marcar Entregado"
                            class="oe_highlight"
                            invisible="state != 'signed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,signed,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Datos del Examen">
                            <field name="order_id"/>
                            <field name="patient_id"/>
                            <field name="employer_id"/>
                        </group>
                        <group string="Certificación">
                            <field name="practitioner_id"/>
                            <field name="signed_date" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <!-- Resumen de estudios de la orden (readonly, referencia para el auditor) -->
                    <group string="Resumen de Estudios">
                        <field name="order_id" invisible="1"/>
                    </group>
                    <group string="Dictamen" class="oe_highlight">
                        <field name="dictamen" widget="radio"/>
                        <field name="observations"
                               placeholder="Observaciones (obligatorio si APTO CON OBSERVACIONES)"
                               invisible="dictamen != 'apto_obs'"/>
                    </group>
                    <group string="Firma Digital" invisible="state == 'draft'">
                        <field name="signature" widget="image"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="medical_certificate_view_list" model="ir.ui.view">
        <field name="name">medical.certificate.list</field>
        <field name="model">medical.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="employer_id"/>
                <field name="dictamen" widget="badge"
                       decoration-success="dictamen == 'apto'"
                       decoration-danger="dictamen == 'no_apto'"
                       decoration-warning="dictamen == 'apto_obs'"/>
                <field name="practitioner_id"/>
                <field name="signed_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'signed'"
                       decoration-muted="state == 'delivered'"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="medical_certificate_view_search" model="ir.ui.view">
        <field name="name">medical.certificate.search</field>
        <field name="model">medical.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="employer_id"/>
                <filter name="apto" string="Aptos" domain="[('dictamen', '=', 'apto')]"/>
                <filter name="no_apto" string="No Aptos" domain="[('dictamen', '=', 'no_apto')]"/>
                <filter name="apto_obs" string="Con Observaciones" domain="[('dictamen', '=', 'apto_obs')]"/>
                <separator/>
                <filter name="group_dictamen" string="Dictamen" context="{'group_by': 'dictamen'}"/>
                <filter name="group_employer" string="Empresa" context="{'group_by': 'employer_id'}"/>
                <filter name="group_practitioner" string="Médico" context="{'group_by': 'practitioner_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="medical_certificate_action" model="ir.actions.act_window">
        <field name="name">Certificados</field>
        <field name="res_model">medical.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
