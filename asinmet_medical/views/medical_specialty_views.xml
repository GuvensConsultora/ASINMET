<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_specialty_view_list" model="ir.ui.view">
        <field name="name">medical.specialty.list</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="medical_specialty_view_form" model="ir.ui.view">
        <field name="name">medical.specialty.form</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_specialty_action" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">medical.specialty</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
