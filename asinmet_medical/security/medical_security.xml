<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grupo: Recepción — crea órdenes, pacientes, turnos -->
    <record id="group_reception" model="res.groups">
        <field name="name">Medicina Laboral: Recepción</field>
    </record>

    <!-- Grupo: Técnico — ve/completa estudios de su especialidad -->
    <record id="group_technician" model="res.groups">
        <field name="name">Medicina Laboral: Técnico / Profesional</field>
        <field name="implied_ids" eval="[(4, ref('group_reception'))]"/>
    </record>

    <!-- Grupo: Auditor — revisa estudios, emite certificados -->
    <record id="group_auditor" model="res.groups">
        <field name="name">Medicina Laboral: Médico Auditor</field>
        <field name="implied_ids" eval="[(4, ref('group_technician'))]"/>
    </record>

    <!-- Grupo: Manager — acceso total, reportes, configuración -->
    <record id="group_manager" model="res.groups">
        <field name="name">Medicina Laboral: Administrador</field>
        <field name="implied_ids" eval="[(4, ref('group_auditor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Regla: Técnico solo ve solicitudes asignadas o sin asignar -->
    <record id="rule_technician_own_specialty" model="ir.rule">
        <field name="name">Técnico: solo estudios de su especialidad</field>
        <field name="model_id" ref="model_medical_study_request"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[
            '|',
            ('practitioner_id.partner_id.user_ids', 'in', [user.id]),
            ('practitioner_id', '=', False)
        ]</field>
    </record>
</odoo>
